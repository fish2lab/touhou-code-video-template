    "canvas2d",
    "paper-cut",
    "chibi",
    "yukkuri",
    "aquestalk",
    "explainer-video",
    "video-generation",
    "deterministic-rendering",
    "ai-agents",
    "template"
  ],
  "homepage": "https://fish2lab.github.io/touhou-code-video-template/",
